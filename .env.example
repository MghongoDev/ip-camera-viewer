# Copy this file to .env and fill in your own values. Never commit .env.
# Use the HTTPS address shown by the IP Webcam app.
CAMERA_URL=https://<phone-ip>:8080/video
CAMERA_NAME=Office Cam
DISPLAY_WIDTH=960
MAX_RECONNECTS=5
RECONNECT_DELAY=2
REQUEST_TIMEOUT=5
# IP Webcam serves a self-signed certificate. Keep false unless you install its CA.
CAMERA_VERIFY_SSL=false
